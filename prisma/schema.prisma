generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  role         String      @default("member") // "admin" | "member"
  createdAt    DateTime    @default(now())
  sessions     Session[]
  tasks        Task[]      @relation("TaskAssignee")
  createdTasks Task[]      @relation("TaskCreator")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  color       String   @default("#6366f1")
  status      String   @default("active") // "active" | "archived"
  createdAt   DateTime @default(now())
  tasks       Task[]
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String   @default("") // HTML из форматированного редактора
  status      String   @default("todo") // "todo" | "in_progress" | "done"
  priority    String   @default("normal") // "low" | "normal" | "high" | "critical"
  assigneeId  String?
  createdById String? // кто создал — редактирует, пока исполнитель не назначен
  dueDate     String? // YYYY-MM-DD
  estimate    Float? // hours
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
}
